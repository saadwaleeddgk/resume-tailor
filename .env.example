# Public browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Backend only: never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_ai_provider_key

# Optional aliases; if set, they must match the frontend project
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_publishable_or_anon_key
# AUTH_USERS_VALID_AFTER=your_account_reset_timestamp

# Optional stable server-only HMAC secret for IP quota identifiers.
# If omitted, the service-role key is used. Changing this resets network buckets.
# IP_QUOTA_SECRET=generate_a_random_secret_and_keep_it_stable

# Optional: choose one AI provider instead of automatic fallback
# AI_PROVIDER=gemini
# GitHub repository/deployment tokens are NOT AI credentials by default.
# Enable only with an intentionally configured GitHub Models token:
# ENABLE_GITHUB_MODELS=true
